---
interface Props {
  tier: 'starter' | 'pro' | 'business' | 'enterprise';
}

const { tier } = Astro.props;

const labels: Record<string, string> = {
  starter: 'Starter',
  pro: 'Pro',
  business: 'Business',
  enterprise: 'Enterprise',
};
---

<span class={`tier-badge tier-badge--${tier}`}>
  {labels[tier]}
</span>
